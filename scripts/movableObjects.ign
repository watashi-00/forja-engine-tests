# Script "movableObjects".
# Para usar num objeto: selecione o objeto na cena e escolha este script no Inspetor.
importe forja


classe MovableObjects herda forja.Objeto:

    função is_movable(inst : Objeto):
        retorne inst.grupo == "movable"
        passe
        
    função move(inst : Objeto):
        se este.is_movable(inst):
            escreva("is movable")
            passe
        passe