importe forja

classe PGunner herda forja.Objeto:

    speed = 200

    função pronto():
        este.grupo = "player"
        este.score = 0
        este.health = 3
        este.damage_cooldown = 0
        este.alive = verdadeiro
        este.facing_x = 0
        este.facing_y = -1
        este.attack_cooldown = 0
        passe

    função atualizar(dt):
        se não este.alive:
            retorne

        horizontal = 0
        vertical = 0

        se forja.acao("move_left"):
            horizontal -= 1

        se forja.acao("move_right"):
            horizontal += 1

        se forja.acao("move_up"):
            vertical -= 1

        se forja.acao("move_down"):
            vertical += 1

        se horizontal != 0 ou vertical != 0:
            factor = 1

            se horizontal != 0 e vertical != 0:
                factor = 0.70710678118

            este.facing_x = horizontal * factor
            este.facing_y = vertical * factor

            este.x += este.facing_x * este.speed * dt
            este.y += este.facing_y * este.speed * dt

            se horizontal == 0:
                se vertical < 0:
                    este.rotacao = 0
                senão:
                    este.rotacao = 180

            senão se vertical == 0:
                se horizontal < 0:
                    este.rotacao = 270
                senão:
                    este.rotacao = 90

            senão se horizontal < 0:
                se vertical < 0:
                    este.rotacao = 315
                senão:
                    este.rotacao = 225

            senão:
                se vertical < 0:
                    este.rotacao = 45
                senão:
                    este.rotacao = 135

        este.check_damage(dt)

        se este.alive:
            este.check_collectibles()
            este.check_attack(dt)

        passe

    função check_collectibles():
        collectible = este.colide_grupo("collectible")

        se collectible e não collectible.collected:
            collectible.collected = verdadeiro
            collectible.visivel = falso

            este.score += 1

            escreva(
                f"[PGunner] Fragment collected. Score: {este.score}"
            )

        passe

    função check_damage(dt):
        se este.damage_cooldown > 0:
            este.damage_cooldown -= dt

        se este.damage_cooldown <= 0:
            enemy = este.colide_grupo("enemies")

            se enemy:
                este.health -= 1
                este.damage_cooldown = 1.0

                escreva(
                    f"[PGunner] Damage taken. Health: {este.health}"
                )

                se este.health <= 0:
                    este.alive = falso
                    este.visivel = falso
                    este.grupo = "dead"

                    escreva("[PGunner] Player defeated.")

        passe

    função check_attack(dt):
        se este.attack_cooldown > 0:
            este.attack_cooldown -= dt

        se forja.acao("attack") e este.attack_cooldown <= 0:
            spawn_x = este.x + este.largura / 2 + este.facing_x * 20 - 4
            spawn_y = este.y + este.altura / 2 + este.facing_y * 20 - 4

            projectile = forja.crie_modelo(
                "pulse",
                spawn_x,
                spawn_y
            )

            projectile.velocity_x = este.facing_x * projectile.speed
            projectile.velocity_y = este.facing_y * projectile.speed

            este.attack_cooldown = 0.25

        passe