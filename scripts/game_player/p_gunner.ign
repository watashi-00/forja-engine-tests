importe forja

classe PGunner herda forja.Objeto:

    speed = 200

    função atualizar(dt):
        horizontal = 0
        vertical = 0

        se forja.acao("move_left"):
            horizontal -= 1

        se forja.acao("move_right"):
            horizontal += 1

        se forja.acao("move_up"):
            vertical -= 1

        se forja.acao("move_down"):
            vertical += 1

        se horizontal != 0 ou vertical != 0:
            factor = 1

            se horizontal != 0 e vertical != 0:
                factor = 0.70710678118

            este.x += horizontal * este.speed * factor * dt
            este.y += vertical * este.speed * factor * dt

            se horizontal == 0:
                se vertical < 0:
                    este.rotacao = 0
                senão:
                    este.rotacao = 180

            senão se vertical == 0:
                se horizontal < 0:
                    este.rotacao = 270
                senão:
                    este.rotacao = 90

            senão se horizontal < 0:
                se vertical < 0:
                    este.rotacao = 315
                senão:
                    este.rotacao = 225

            senão:
                se vertical < 0:
                    este.rotacao = 45
                senão:
                    este.rotacao = 135

        passe