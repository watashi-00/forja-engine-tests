importe forja

classe PGunner herda forja.Objeto:

    speed = 200

    função pronto():
        este.keysMapping = {
            "move_up": este.move_up,
            "move_left": este.move_left,
            "move_down": este.move_down,
            "move_right": este.move_right
        }
        passe

    função atualizar(dt):
        para action em este.keysMapping:
            se forja.acao(action):
                este.keysMapping[action](dt)
        passe

    função move_up(dt):
        este.y -= este.speed * dt
        este.rotacao = 0
        passe

    função move_left(dt):
        este.x -= este.speed * dt
        este.rotacao = 270
        passe

    função move_down(dt):
        este.y += este.speed * dt
        este.rotacao = 180
        passe

    função move_right(dt):
        este.x += este.speed * dt
        este.rotacao = 90
        passe