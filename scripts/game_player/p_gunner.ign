importe forja

classe PGunner herda forja.Objeto:

    speed = 200

    função pronto():
        este.grupo = "player"
        este.score = 0
        este.health = 3
        este.damage_cooldown = 0
        este.alive = verdadeiro
        passe

    função atualizar(dt):
        se não este.alive:
            retorne
            
        horizontal = 0
        vertical = 0

        se forja.acao("move_left"):
            horizontal -= 1

        se forja.acao("move_right"):
            horizontal += 1

        se forja.acao("move_up"):
            vertical -= 1

        se forja.acao("move_down"):
            vertical += 1

        se horizontal != 0 ou vertical != 0:
            factor = 1

            se horizontal != 0 e vertical != 0:
                factor = 0.70710678118

            este.x += horizontal * este.speed * factor * dt
            este.y += vertical * este.speed * factor * dt

            se horizontal == 0:
                se vertical < 0:
                    este.rotacao = 0
                senão:
                    este.rotacao = 180

            senão se vertical == 0:
                se horizontal < 0:
                    este.rotacao = 270
                senão:
                    este.rotacao = 90

            senão se horizontal < 0:
                se vertical < 0:
                    este.rotacao = 315
                senão:
                    este.rotacao = 225

            senão:
                se vertical < 0:
                    este.rotacao = 45
                senão:
                    este.rotacao = 135

        este.check_collectibles()
        este.check_damage(dt)
        passe
        
    função check_collectibles():
        collectable = este.colide_grupo("collectible")

        se collectable e não collectable.collected:
            collectable.collected = verdadeiro
            collectable.visivel = falso

            este.score += 1

            escreva(f"[PGunner] Fragment collected. Score: {este.score}")

        passe
        
    função check_damage(dt):
        se este.damage_cooldown > 0:
            este.damage_cooldown -= dt

        se este.damage_cooldown <= 0:
            enemy = este.colide_grupo("enemies")

            se enemy:
                este.health -= 1
                este.damage_cooldown = 1.0

                escreva(
                    f"[PGunner] Damage taken. Health: {este.health}"
                )

                se este.health <= 0:
                    este.alive = falso
                    este.visivel = falso
                    este.grupo = "dead"

                    escreva("[PGunner] Player defeated.")

        passe