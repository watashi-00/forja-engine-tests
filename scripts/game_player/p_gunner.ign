importe forja
importe matematica

classe PGunner herda forja.Objeto:

    health_max = 3
    invuln_time = 1.0
    attack_interval = 0.25
    muzzle_offset = 20

    health = 3
    invuln = 0
    attack_cooldown = 0
    alive = verdadeiro
    facing_x = 0
    facing_y = -1

    função pronto():
        este.health = este.health_max

    função atualizar(dt):
        se não este.alive:
            retorne

        este.update_facing()
        este.update_invuln(dt)
        este.check_damage()

        se este.alive:
            este.check_attack(dt)

    função update_facing():
        dx = forja.eixo_acao("esquerda", "direita")
        dy = forja.eixo_acao("cima", "baixo")

        length = matematica.hipotenusa(dx, dy)

        se length == 0:
            retorne

        este.facing_x = dx / length
        este.facing_y = dy / length

        este.rotacao = (forja.direcao(0, 0, este.facing_x, este.facing_y) + 90) % 360

    função update_invuln(dt):
        se este.invuln <= 0:
            retorne

        este.invuln -= dt

        se este.invuln <= 0:
            este.alfa = 1
        senão:
            este.alfa = 0.35 se inteiro(este.invuln * 15) % 2 == 0 senão 1

    função check_damage():
        se este.invuln > 0:
            retorne

        se este.colide_grupo("enemies") != nulo:
            este.take_damage(1)

    função take_damage(amount):
        se não este.alive ou este.invuln > 0:
            retorne

        este.health -= amount
        este.invuln = este.invuln_time

        forja.som("dano")
        forja.camera.trema(5, 0.2)

        se este.health <= 0:
            este.die()

    função die():
        este.alive = falso
        este.visivel = falso
        este.ativo = falso

        forja.pontos = 0

        cx, cy = este.centro()
        forja.particulas(cx, cy, 40, "vermelho", velocidade = 250, vida = 0.7)
        forja.som("perdeu")
        forja.camera.trema(8, 0.4)

        forja.espere(1.5, forja.reinicie_cena)

    função check_attack(dt):
        se este.attack_cooldown > 0:
            este.attack_cooldown -= dt

        se não forja.acao("attack") ou este.attack_cooldown > 0:
            retorne

        este.attack_cooldown = este.attack_interval

        cx, cy = este.centro()
        angle = forja.direcao(0, 0, este.facing_x, este.facing_y)
        ox, oy = forja.vetor(este.muzzle_offset, angle)

        bullet = forja.crie_modelo("pulse", 0, 0)
        bullet.x = cx + ox - bullet.largura / 2
        bullet.y = cy + oy - bullet.altura / 2

        bullet.adicione_comportamento("mover", { "direcao": angle, "velocidade": bullet.speed })
        bullet.adicione_comportamento("sumir_fora")

        forja.som("tiro", volume = 0.4)