importe forja

classe Pulse herda forja.Objeto:

    speed = 420
    lifetime = 1.5
    damage = 1
    spent = falso

    função pronto():
        este.alarme(0, este.lifetime)

    função ao_alarme(numero):
        se numero == 0:
            este.destrua()

    função ao_colidir(other):
        se este.spent ou other.grupo != "enemies":
            retorne

        se tem_atributo(other, "take_damage"):
            este.spent = verdadeiro
            other.take_damage(este.damage)
            este.destrua()