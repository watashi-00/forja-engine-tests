importe forja

classe Zombie herda forja.Objeto:

    speed = 70
    health = 3
    dead = falso
    target = nulo

    função atualizar(dt):
        este.find_target()

        se este.target == nulo:
            retorne

        se este.colide(este.target):
            retorne

        dx, dy = forja.vetor(este.speed * dt, este.direcao_ate(este.target))
        este.mova(dx, dy)

    função find_target():
        se este.target != nulo e este.target.ativo:
            retorne

        cx, cy = este.centro()
        este.target = forja.mais_proximo(cx, cy, "player")

    função take_damage(amount):
        se este.dead:
            retorne

        este.health -= amount

        se este.health > 0:
            forja.som("dano", volume = 0.3, tom = 1.4)
            retorne

        este.dead = verdadeiro
        cx, cy = este.centro()

        forja.particulas(cx, cy, 20, este.cor, cor_final = "#0a3010", velocidade = 160, vida = 0.5)
        forja.som("explosao", volume = 0.4)

        drop = forja.crie_modelo("fragment", 0, 0)
        drop.x = cx - drop.largura / 2
        drop.y = cy - drop.altura / 2

        este.destrua()