importe forja

classe Zombie herda forja.Objeto:

    função pronto():
        este.grupo = "enemies"
        este.speed = 70
        este.health = 3
        este.active = verdadeiro
        passe

    função atualizar(dt):
        se não este.active:
            retorne

        se este.colide_grupo("player"):
            retorne

        para player em forja.grupo("player"):
            horizontal = 0
            vertical = 0

            se player.x < este.x:
                horizontal = -1
            senão se player.x > este.x:
                horizontal = 1

            se player.y < este.y:
                vertical = -1
            senão se player.y > este.y:
                vertical = 1

            factor = 1

            se horizontal != 0 e vertical != 0:
                factor = 0.70710678118

            este.x += horizontal * este.speed * factor * dt
            este.y += vertical * este.speed * factor * dt

        passe

    função take_damage(damage):
        se não este.active:
            retorne

        este.health -= damage

        escreva(f"[Zombie] Damage taken. Health: {este.health}")

        se este.health <= 0:
            este.active = falso
            este.visivel = falso
            este.grupo = "defeated"

            escreva("[Zombie] Enemy defeated.")

        passe