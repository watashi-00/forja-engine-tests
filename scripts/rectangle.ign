# Script do objeto "Retângulo".
importe forja
importe mouseVector

classe Retângulo herda forja.Objeto:
    mouse = mouseVector.mouse

    # Chamado uma vez, quando a cena começa.
    função pronto():
        passe

    # Chamado todo quadro. dt = segundos desde o último quadro.
    # Use este.x, este.y, este.cor, este.largura... para mudar o objeto.
    função atualizar(dt):
        
        
        ## x start at left bottom and y start at left top
        se este.mouse.x >= este.x e este.mouse.x <= este.x + este.largura e este.mouse.y >= este.y e este.mouse.y <= este.y + este.altura:
            escreva("Mouse over rectangle")
        senão:
            escreva("Mouse X:", este.mouse.x, "Mouse Y:", este.mouse.y)
            escreva("Rectangle X:", este.x, "Rectangle Y:", este.y)
        passe