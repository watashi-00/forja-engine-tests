# Script "mouseVector".
# Para usar num objeto: selecione o objeto na cena e escolha este script no Inspetor.
importe forja


classe MouseVector herda forja.Objeto:
    
    função create(x, y):
        este.x = x
        este.y = y    
        passe
        
    função capture():
        mx, my = forja.mouse()
        este.create(mx, my)
        passe
        
        
## singleton?
mouse = MouseVector()