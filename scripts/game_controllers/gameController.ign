importe forja
importe aleatorio

classe GameController herda forja.Objeto:

    spawn_min = 2
    spawn_max = 4
    max_enemies = 8
    spawn_margin = 64
    min_player_distance = 240
    spawn_attempts = 16
    enemy_size = 32
    default_world = 1488

    função pronto():
        este.spawn_timer = aleatorio.uniforme(este.spawn_min, este.spawn_max)

    função atualizar(dt):
        este.spawn_timer -= dt

        se este.spawn_timer > 0:
            retorne

        este.spawn_timer = aleatorio.uniforme(este.spawn_min, este.spawn_max)

        se tamanho(forja.grupo("enemies")) >= este.max_enemies:
            retorne

        players = forja.grupo("player")

        se tamanho(players) == 0:
            retorne

        point = este.find_spawn_point(players[0])

        se point == nulo:
            retorne

        forja.crie_modelo("zombie", point[0], point[1])

    # Find a point just outside the camera, inside the world and far from the player.
    função find_spawn_point(player):
        camera = forja.camera
        view_w = forja.largura / camera.zoom
        view_h = forja.altura / camera.zoom

        # Get world bounds from the camera; use the default if no limits are defined.
        world_x = 0
        world_y = 0
        world_w = este.default_world
        world_h = este.default_world

        se camera.limites != nulo:
            world_x, world_y, world_w, world_h = camera.limites

        left = camera.x - este.spawn_margin - este.enemy_size
        right = camera.x + view_w + este.spawn_margin
        top = camera.y - este.spawn_margin - este.enemy_size
        bottom = camera.y + view_h + este.spawn_margin

        para attempt em intervalo(este.spawn_attempts):
            side = aleatorio.inteiro(0, 3)

            se side == 0:
                x = left
                y = aleatorio.uniforme(camera.y, camera.y + view_h - este.enemy_size)
            senão se side == 1:
                x = right
                y = aleatorio.uniforme(camera.y, camera.y + view_h - este.enemy_size)
            senão se side == 2:
                x = aleatorio.uniforme(camera.x, camera.x + view_w - este.enemy_size)
                y = top
            senão:
                x = aleatorio.uniforme(camera.x, camera.x + view_w - este.enemy_size)
                y = bottom

            inside_world = (
                x >= world_x e
                y >= world_y e
                x <= world_x + world_w - este.enemy_size e
                y <= world_y + world_h - este.enemy_size
            )

            se inside_world e forja.distancia(x, y, player.x, player.y) >= este.min_player_distance:
                retorne [x, y]

        retorne nulo