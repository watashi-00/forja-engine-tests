importe forja

classe MovableObjects herda forja.Objeto:

    função is_movable(inst: Objeto):
        retorne (inst._uid em objectList) ou (inst.grupo == "movable")
        
    função prepare(inst: Objeto):
        inst._mov_origin = inst.rotacao
        inst._mov_offset = 0
        inst._mov_direction = 1
    passe
        
    função move(inst: Objeto, dt):
        se não este.is_movable(inst):
            retorne
            
        se não (inst._uid em objectList):
            escreva("[MovableObjects] Preparing:", inst._uid)
            este.prepare(inst)
            objectList[inst._uid] = verdadeiro
            
        este._mov_anim(inst, dt)
        
        passe
        
    função _mov_anim(inst: Objeto, dt):
        inst._mov_offset += inst._mov_direction * 180 * dt

        se inst._mov_offset >= 45:
            inst._mov_offset = 45
            inst._mov_direction = -1

        senão se inst._mov_offset <= -45:
            inst._mov_offset = -45
            inst._mov_direction = 1

        inst.rotacao = inst._mov_origin + inst._mov_offset
    passe
        
objectList = {}