importe forja
importe movableObjects

classe MouseController herda forja.Objeto:
    
    função pronto():
        este.selected = nulo
        passe
        
    função atualizar(dt):  
        mouse.step(dt)
        passe

    função capture(dt):
        mx, my = forja.mouse_no_mundo()
        este.x = mx
        este.y = my

        current = forja.acao("action")
        
        se current != este.previous_action:
            escreva(f"[MouseController] action changed: {este.previous_action} -> {current}")

        este.clicked = current e não este.previous_action
        este.pressed = current
        este.released = este.previous_action e não current

        este.long_pressed = falso

        se current:
            este.hold_time = este.hold_time + dt

            se este.hold_time >= 0.5 e não este.hold_triggered:
                este.long_pressed = verdadeiro
                este.hold_triggered = verdadeiro
        senão:
            este.hold_time = 0
            este.hold_triggered = falso

        este.previous_action = current
        passe
                
    função is_over(inst : Object):
        inside = (
            este.x >= inst.x e
            este.x <= inst.x + inst.largura e
            este.y >= inst.y e
            este.y <= inst.y + inst.altura
        )
        
        se inside:
            escreva("[Mouse Controller] Hit:", inst._uid)
        retorne inside

    função handle_objects(dt):
        se este.clicked:
            escreva("[MouseController] Click detected")
            este.selected = nulo

            para inst em forja.grupo("movable"):
                se este.is_over(inst):
                    escreva(f"[MouseController] Selected: {inst._uid}")
                    este.selected = inst
                    pare

            se não este.selected:
                escreva("[MouseController] No object selected")

        se este.released:
            este.selected = nulo

        se este.pressed e este.selected:
            movableObjects.MovableObjects().move(este.selected, dt)
            
        passe
        
    função step(dt):
        mouse.capture(dt)
        mouse.handle_objects(dt)
        passe
    

mouse = MouseController()
mouse.previous_action = falso
mouse.hold_time = 0
mouse.hold_triggered = falso